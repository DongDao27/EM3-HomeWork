<dialog class="product-popup" id="product-<%= product.id %>" aria-labelledby="popup-title-<%= product.id %>">
    <button class="popup-close" type="button" data-close-product aria-label="Đóng chi tiết sản phẩm" autofocus>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
    </button>
    <div class="popup-layout">
        <div class="popup-gallery">
            <%- include('gallery', { product }) %>
        </div>
        <div class="popup-content">
            <h2 id="popup-title-<%= product.id %>"><%= product.name %></h2>
            <p class="product-category"><%= product.category || 'Khác' %></p>
        <p class="detail-price"><%= Number(product.price).toLocaleString('vi-VN') %> <span>VNĐ</span></p>
            <p class="quantity-text">Số lượng: <%= product.quantity %></p>
        </div>
    </div>
</dialog>
