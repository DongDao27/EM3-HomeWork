<% const selectedCategory = typeof locals.category === 'string' ? locals.category : ''; %>
<% const categoryList = Array.isArray(locals.categories) ? locals.categories : ['Khác']; %>
<%- include('partials/header', { title: 'Danh sách sản phẩm' }) %>

<% if (!q && !selectedCategory) { %>
    <section class="store-banner" aria-label="Banner giày thể thao">
        <img class="banner-image" src="/images/banner-sneakers-hd.png" alt="Sneakers — giày thể thao">
    </section>
<% } %>

<section id="products" class="products-section" aria-labelledby="products-title">

<div class="catalog-heading">
    <h2 id="products-title">Sản phẩm</h2>
    <div class="catalog-tools">
        <form action="/search" method="GET" class="search-form">
            <input type="hidden" name="category" value="<%= selectedCategory %>">
            <label for="search" class="visually-hidden">Tìm theo tên</label>
            <input id="search" class="form-control" name="q" maxlength="100" placeholder="Tìm theo tên" value="<%= q %>">
            <button class="btn btn-primary">Tìm</button>
            <% if (q) { %>
                <a class="btn btn-outline-secondary" href="/?category=<%= encodeURIComponent(selectedCategory) %>#products">Bỏ lọc</a>
            <% } %>
        </form>
        <a href="/add" class="btn btn-primary add-product">Thêm sản phẩm</a>
    </div>
</div>

<nav class="category-list" aria-label="Danh mục sản phẩm">
    <a class="category-link <%= !selectedCategory ? 'is-active' : '' %>" href="/?q=<%= encodeURIComponent(q) %>#products" <%- !selectedCategory ? 'aria-current="page"' : '' %>>Tất cả</a>
    <% categoryList.forEach(name => { %>
        <a class="category-link <%= selectedCategory === name ? 'is-active' : '' %>" href="/?category=<%= encodeURIComponent(name) %>&q=<%= encodeURIComponent(q) %>#products" <%- selectedCategory === name ? 'aria-current="page"' : '' %>><%= name %></a>
    <% }) %>
</nav>

<% if (!products.length) { %>
    <p class="empty-state"><%= q ? 'Không tìm thấy sản phẩm.' : 'Chưa có sản phẩm trong danh mục này.' %></p>
<% } %>

<div class="row g-4">
    <% products.forEach(product => { %>
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <article class="card product-card h-100">
                <%- include('partials/gallery', { product }) %>
                <div class="card-body">
                    <h2 class="product-title"><%= product.name %></h2>
                    <p class="product-price"><%= Number(product.price).toLocaleString('vi-VN') %> <span>VNĐ</span></p>
                    <p class="quantity-text">Số lượng: <%= product.quantity %></p>
                    <div class="card-actions">
                        <button class="btn btn-primary buy-button" type="button" data-open-product="product-<%= product.id %>" aria-haspopup="dialog" aria-controls="product-<%= product.id %>">Mua ngay</button>
                        <a class="icon-button" href="/edit/<%= product.id %>" title="Sửa sản phẩm" aria-label="Sửa <%= product.name %>">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 4 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15z"/></svg>
                        </a>
                        <form action="/delete/<%= product.id %>" method="POST" onsubmit="return confirm('Xóa sản phẩm này?')">
                            <button class="icon-button icon-delete" title="Xóa sản phẩm" aria-label="Xóa <%= product.name %>">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        </div>
    <% }) %>
</div>

</section>

<% products.forEach(product => { %>
    <%- include('partials/productPopup', { product }) %>
<% }) %>

<%- include('partials/footer') %>
